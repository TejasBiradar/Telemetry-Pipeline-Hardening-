# Copy to .env and adjust. Never commit the real .env (CLAUDE.md rule 2 / .gitignore).
POSTGRES_USER=teleguard
POSTGRES_PASSWORD=teleguard
POSTGRES_DB=teleguard
DATABASE_URL=postgresql://teleguard:teleguard@localhost:5432/teleguard

# off | observe | enforce (teleguard/config.py). Start in observe until checks are trusted.
TELEGUARD_MODE=observe

# Demo email notify — Gmail App Password required (Google Account → Security → 2-Step → App passwords).
# Prefer 465 + SSL on WSL; 587 + STARTTLS is the alternate.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=you@gmail.com
SMTP_PASSWORD=xxxxxxxxxxxxxxxx
SMTP_FROM=you@gmail.com
